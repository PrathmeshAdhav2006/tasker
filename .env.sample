# ─── Primary ───────────────────────────────────────────────
NOTESAPP_PRIMARY.ENV="local"
NOTESAPP_PRIMARY.LOG_LEVEL="debug"

# ─── Server ────────────────────────────────────────────────
NOTESAPP_SERVER.PORT="8080"
NOTESAPP_SERVER.READ_TIMEOUT="30"
NOTESAPP_SERVER.WRITE_TIMEOUT="30"
NOTESAPP_SERVER.IDLE_TIMEOUT="60"
NOTESAPP_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ─── Database ──────────────────────────────────────────────
NOTESAPP_DATABASE.HOST="localhost"
NOTESAPP_DATABASE.PORT="5432"
NOTESAPP_DATABASE.USER="postgres"
NOTESAPP_DATABASE.PASSWORD=""
NOTESAPP_DATABASE.NAME="boilerplate"
NOTESAPP_DATABASE.SSL_MODE="disable"
NOTESAPP_DATABASE.MAX_OPEN_CONNS="25"
NOTESAPP_DATABASE.MAX_IDLE_CONNS="25"
NOTESAPP_DATABASE.CONN_MAX_LIFETIME="300"
NOTESAPP_DATABASE.CONN_MAX_IDLE_TIME="300"

# ─── Auth ──────────────────────────────────────────────────
NOTESAPP_AUTH.SECRET_KEY="change-me"

# ─── Redis ─────────────────────────────────────────────────
NOTESAPP_REDIS.ADDRESS="localhost:6379"

# ─── Integration ───────────────────────────────────────────
NOTESAPP_INTEGRATION.RESEND_API_KEY=""